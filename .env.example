# DeepSeek API（必填，用于 AI 文献结构识别）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 以下为可选项，使用默认值时保持注释即可
# DeepSeek API 地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 使用的模型
# DEEPSEEK_MODEL=deepseek-v4-flash

# NCBI E-utilities（选填，建议填写以提升 Pubmed 查询限额）
# NCBI_API_KEY=
# 请求 NCBI 时使用的邮箱
# MY_EMAIL=you@example.com

# Semantic Scholar（选填；不填写也可使用公开接口，但限流更严格）
# SEMANTIC_SCHOLAR_API_KEY=

# 引用内容初筛邀请码与每日额度（必填；在 Streamlit Cloud 中放入 Secrets）
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ACCESS_CODE_PEPPER=use-a-long-random-secret
# 单次任务最多 DeepSeek 调用数，默认 150
# SCREENING_MAX_CALLS_PER_TASK=150
PUBLIC_MAX_REFERENCES=150
PUBLIC_MAX_TOTAL_CHARS=60000
PUBLIC_MAX_REFERENCE_CHARS=1500
